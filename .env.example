# Copy to .env and fill in. Never commit .env.
# Comments are kept on their own lines so every env parser reads the values cleanly.

# --- App ---
# local | dev | prod
APP_ENV=local
LOG_LEVEL=INFO

# --- Database ---
# Postgres for local/dev/prod. SQLite is only used by fast unit tests.
DATABASE_URL=postgresql+psycopg://echonotes:echonotes@localhost:5432/echonotes
POSTGRES_USER=echonotes
POSTGRES_PASSWORD=echonotes
POSTGRES_DB=echonotes

# --- Transcription ---
# fake (deterministic, no key needed) | groq (real, needs GROQ_API_KEY; the app refuses to start without it)
TRANSCRIBER_PROVIDER=fake
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=whisper-large-v3-turbo
TRANSCRIBE_TIMEOUT_SECONDS=120

# --- Upload limits ---
MAX_AUDIO_MB=25
MAX_IMAGE_MB=5

# --- Static SPA ---
# Directory with the built frontend (index.html + assets/) served by FastAPI.
# Empty = API only (local dev, tests). The Docker image and docker compose set /app/static.
STATIC_DIR=

# --- Deployed commit (GET /api/health `commit`) ---
# The Docker image bakes GIT_SHA in from the build arg (CI passes the commit SHA). Kept
# commented out on purpose: docker compose reads .env as env_file, and an empty GIT_SHA= there
# would replace the image's value. Uncomment only when running uvicorn on the host.
# Unset everywhere -> health reports "unknown".
# RENDER_GIT_COMMIT is set by Render at runtime and wins over GIT_SHA (do not set it yourself).
# GIT_SHA=

# --- Frontend (Vite dev server only) ---
VITE_API_BASE_URL=http://localhost:8000

# --- Observability (OpenTelemetry, #29; see docs/observability.md) ---
# OTLP http/protobuf base URL, e.g. http://lgtm:4318 (compose) or http://localhost:4318.
# Empty = telemetry fully off: no SDK, no exporters (tests, CI and Render prod run like this).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=echonotes-api
# Metric export interval in milliseconds (short so the local demo updates quickly).
OTEL_METRIC_EXPORT_INTERVAL=5000
# Optional exporter headers, e.g. a hosted backend's auth (secret: never commit a value).
OTEL_EXPORTER_OTLP_HEADERS=
