# Copy to .env and fill in. Never commit .env.
# Comments are kept on their own lines so every env parser reads the values cleanly.

# --- App ---
# local | dev | prod
APP_ENV=local
LOG_LEVEL=INFO

# --- Database ---
# Postgres for local/dev/prod. SQLite is only used by fast unit tests.
DATABASE_URL=postgresql+psycopg://echonotes:echonotes@localhost:5432/echonotes
POSTGRES_USER=echonotes
POSTGRES_PASSWORD=echonotes
POSTGRES_DB=echonotes

# --- Transcription ---
# fake (deterministic, no key needed) | groq (real, needs GROQ_API_KEY; the app refuses to start without it)
TRANSCRIBER_PROVIDER=fake
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=whisper-large-v3-turbo
TRANSCRIBE_TIMEOUT_SECONDS=120

# --- AI project summary (US-22) ---
# gemini | groq | fake. Empty = auto: gemini when GEMINI_API_KEY is set, otherwise fake.
# An explicit gemini without GEMINI_API_KEY (or groq without GROQ_API_KEY) refuses to start.
# Privacy: summaries send the project's transcripts and screenshots to the provider; the
# Gemini free tier may use that content to improve Google products.
SUMMARIZER_PROVIDER=
# Secret: never commit a value.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash
# Retried once on 429 (quota exhausted), 500 or 503 (overloaded). Empty = no fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# groq summaries reuse GROQ_API_KEY and GROQ_BASE_URL (text only, no images sent).
GROQ_SUMMARY_MODEL=openai/gpt-oss-120b
# Whole job, fallback included.
SUMMARY_TIMEOUT_SECONDS=90
# Total transcript characters sent; above it the text is cut and the summary says so.
SUMMARY_MAX_CHARS=60000
SUMMARY_MAX_IMAGES=8
# Longest side of each screenshot after downscaling, in pixels.
SUMMARY_IMAGE_MAX_PX=1280
# Total bytes of all (re-encoded) images sent and embedded in summary.html; beyond it images
# are left out and the summary is marked truncated. 4194304 = 4 MB.
SUMMARY_MAX_IMAGE_BYTES=4194304

# --- Upload limits ---
MAX_AUDIO_MB=25
MAX_IMAGE_MB=5

# --- Static SPA ---
# Directory with the built frontend (index.html + assets/) served by FastAPI.
# Empty = API only (local dev, tests). The Docker image and docker compose set /app/static.
STATIC_DIR=

# --- Deployed commit (GET /api/health `commit`) ---
# The Docker image bakes GIT_SHA in from the build arg (CI passes the commit SHA). Kept
# commented out on purpose: docker compose reads .env as env_file, and an empty GIT_SHA= there
# would replace the image's value. Uncomment only when running uvicorn on the host.
# Unset everywhere -> health reports "unknown".
# RENDER_GIT_COMMIT is set by Render at runtime and wins over GIT_SHA (do not set it yourself).
# GIT_SHA=

# --- docker compose: host ports and local observability stack (#30, docs/observability.md) ---
# All optional, kept commented out: docker compose has the defaults, and `make obs-up` sets
# OBS_OTLP_ENDPOINT itself. Uncomment to run a second stack next to the default one.
# APP_PORT=8000
# GRAFANA_PORT=3000
# APP_IMAGE=echonotes:local
# Alert contact point (the on-call responder on the host).
# ONCALL_WEBHOOK_URL=http://host.docker.internal:9095/alert
# The app's OTLP endpoint in compose; empty = telemetry off (plain `docker compose up`).
# OBS_OTLP_ENDPOINT=
# ENABLE_LOGS_GRAFANA=false

# --- Frontend (Vite dev server only) ---
VITE_API_BASE_URL=http://localhost:8000

# --- Observability (OpenTelemetry, #29; see docs/observability.md) ---
# OTLP http/protobuf base URL, e.g. http://lgtm:4318 (compose) or http://localhost:4318.
# Empty = telemetry fully off: no SDK, no exporters (tests, CI and Render prod run like this).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=echonotes-api
# Metric export interval in milliseconds (short so the local demo updates quickly).
OTEL_METRIC_EXPORT_INTERVAL=5000
# Optional exporter headers, e.g. a hosted backend's auth (secret: never commit a value).
OTEL_EXPORTER_OTLP_HEADERS=
