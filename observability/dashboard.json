    {
      "type": "logs",
      "title": "Recent failure logs: WARN, ERROR, FATAL (Loki)",
      "description": "WARN/ERROR/FATAL records of echonotes-api: provider errors and timeouts (502/504) log at WARN, unhandled exceptions (500) at ERROR. Expand a line and use the trace_id link to open the trace in Tempo. Logs carry IDs, status codes, error classes and stack frames only, never user content.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"echonotes-api\"} | severity_text=~\"WARN|ERROR|FATAL\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Failing traces (Tempo)",
      "description": "Click a trace ID to open it; from a span use 'Logs for this span' to jump to Loki.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"echonotes-api\" && status=error}",
