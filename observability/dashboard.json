            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider, status) (rate(echonotes_transcriptions_total{job=\"echonotes-api\"}[$__rate_interval])) * 60",
          "legendFormat": "{{provider}} {{status}}",
          "range": true
